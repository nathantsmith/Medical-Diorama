[Unit]
Description=Medical Diorama application
Wants=network-online.target graphical.target
After=network-online.target graphical.target

[Service]
Type=simple
User=bhv
Group=bhv
WorkingDirectory=/home/bhv/Medical-Diorama
Environment=PYTHONUNBUFFERED=1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DIORAMA_DISPLAY_WAIT_SECONDS=60
EnvironmentFile=-/home/bhv/Medical-Diorama/.env
ExecStartPre=/bin/sh -c 'i=0; while [ "$$i" -lt "$${DIORAMA_DISPLAY_WAIT_SECONDS:-60}" ]; do for socket in "$${XDG_RUNTIME_DIR}"/wayland-*; do [ -S "$$socket" ] && exit 0; done; i=$$((i + 1)); sleep 1; done; echo "No Wayland display socket found in $${XDG_RUNTIME_DIR}" >&2; exit 1'
ExecStart=/home/bhv/Medical-Diorama/.venv/bin/python /home/bhv/Medical-Diorama/main.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

# Uncomment and adjust these only if the automatic Wayland discovery in
# xray/process.py selects the wrong desktop session.
# Environment=WAYLAND_DISPLAY=wayland-1
# Environment=DISPLAY=:0

[Install]
WantedBy=multi-user.target
