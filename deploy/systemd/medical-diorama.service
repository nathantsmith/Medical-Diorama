[Unit]
Description=Medical Diorama application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bhv
Group=bhv
WorkingDirectory=/home/bhv/Medical-Diorama
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/bhv/Medical-Diorama/.env
ExecStart=/home/bhv/Medical-Diorama/.venv/bin/python /home/bhv/Medical-Diorama/main.py
 Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

# Uncomment and adjust these if the X-ray pygame windows need an existing
# desktop session instead of SDL's direct display access.
# Environment=XDG_RUNTIME_DIR=/run/user/1000
# Environment=WAYLAND_DISPLAY=wayland-1
# Environment=DISPLAY=:0

[Install]
WantedBy=graphical.target
